#pragma once

#include "rtx/pass/tonemap/tonemapping.h"
#include "rtx/utility/color.slangh"
#include "rtx/utility/common.slangh"
#include "rtx/utility/math.slangh"

#include "ACES.hlsl"

static const uint kHistogramFixedPointScale = 0x100;

float getExposure(RWTexture1D<float> ExposureTex, const bool enableAutoExposure, const float exposureFactor)
{
  float exposure = exposureFactor;
  if (enableAutoExposure)
  {
    exposure *= ExposureTex[0].r;
  }
  return exposure;
}

float sanitizeExposure(float exposure)
{
  if (!isValidValue(exposure) || exposure <= 0.0f)
  {
    return 1.0f;
  }

  return clamp(exposure, 1.0f / float16Max, float16Max);
}

float sanitizeRadiance(float radiance)
{
  return isValidValue(radiance)
    ? clamp(radiance, 0.0f, float16Max)
    : 0.0f;
}

float3 sanitizeRadiance(float3 radiance)
{
  return float3(
    sanitizeRadiance(radiance.x),
    sanitizeRadiance(radiance.y),
    sanitizeRadiance(radiance.z));
}

float normalizedEVToHistogramOffset(float normalizedEV)
{
  // Remap exposure to bucket (1, size-1)
  return (saturate(normalizedEV) * float(EXPOSURE_HISTOGRAM_SIZE - 2)) + 1;
}

float histogramOffsetToNormalizedEV(float offset)
{
  return saturate((offset - 1) / float(EXPOSURE_HISTOGRAM_SIZE - 2));
}

// Approximation of ACES
// https://knarkowicz.wordpress.com/2016/01/06/aces-filmic-tone-mapping-curve/
float3 ACESFilmApproximation(float3 x)
{
  float a = 2.51f;
  float b = 0.03f;
  float c = 2.43f;
  float d = 0.59f;
  float e = 0.14f;
  return saturate((x*(a*x+b))/(x*(c*x+d)+e));
}

// Fork (DS1): DLSS-NR's SDR curve under the game's image pipeline. The game's display is a saturate of the exposed scene, so
// its darks are linear; ACES's toe flattens them about five times, and the inverse after DLSS-NR scaled every change the
// network made there by as much (boiling, a compressed look in dim interiors). Linear up to the knee, then a soft
// shoulder to 1, so highlights still fit the SDR range.
float3 ds1NeuralRenderingCurve(float3 x)
{
  const float knee = 0.8f;
  const float3 above = max(x - knee, 0.0f);
  return min(x, knee) + (1.0f - knee) * (1.0f - exp(-above / (1.0f - knee)));
}

// DS1 HDR10 output (rtx_hdr_output.h). The SDR image clips every channel at 1; with headroom the range the clip
// would cut is spread between a start level and the display's limit instead. Nothing at or below start changes.

// Exponential shoulder: identity up to start, then approaches limit without ever reaching it. The slope is
// continuous at start (1 on both sides), so no edge appears where the shoulder takes over.
float hdrShoulder(float x, float start, float limit)
{
  const float range = max(limit - start, 1e-4f);
  return x <= start ? x : start + range * (1.0f - exp(-(x - start) / range));
}

// The three channels through the shoulder. perChannel 1: each on its own, so the brightest channel compresses
// first and a bright colour turns towards white as it brightens, as it did at the SDR clip but spread over the
// headroom. perChannel 0: all three scaled by what the brightest would get, so the hue holds up to the limit.
float3 hdrRollOff(float3 c, float start, float limit, float perChannel)
{
  const float3 each = float3(hdrShoulder(c.r, start, limit), hdrShoulder(c.g, start, limit), hdrShoulder(c.b, start, limit));
  const float brightest = max(c.r, max(c.g, c.b));
  const float3 together = brightest > start ? c * (hdrShoulder(brightest, start, limit) / brightest) : c;
  return lerp(together, each, saturate(perChannel));
}

// A tone curve continued past the point where it reaches kneeOut: the SDR result is scaled so a grey of the
// pixel's scene luminance would land on the straight line through (kneeIn, kneeOut) with the curve's slope
// there, instead of on the curve's shoulder that fits everything under 1. Below kneeIn the SDR result stands.
float3 hdrContinueCurve(float3 sdrColor, float sceneLum, float kneeIn, float kneeOut, float slope, float curveAtScene)
{
  if (sceneLum <= kneeIn || curveAtScene <= 1e-5f)
  {
    return sdrColor;
  }
  const float target = kneeOut + slope * (sceneLum - kneeIn);
  return sdrColor * max(target / curveAtScene, 1.0f);
}

float3 ACESFilm(float3 color, bool useLegacyACES, bool suppressBlackLevelClamp = false)
{
  if (useLegacyACES)
  {
    return ACESFilmApproximation(color);
  }
  return ACESFitted(color, suppressBlackLevelClamp);
}

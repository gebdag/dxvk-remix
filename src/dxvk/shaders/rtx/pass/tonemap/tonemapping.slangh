#pragma once

#include "rtx/pass/tonemap/tonemapping.h"
#include "rtx/utility/color.slangh"
#include "rtx/utility/common.slangh"
#include "rtx/utility/math.slangh"

#include "ACES.hlsl"

static const uint kHistogramFixedPointScale = 0x100;

float getExposure(RWTexture1D<float> ExposureTex, const bool enableAutoExposure, const float exposureFactor)
{
  float exposure = exposureFactor;
  if (enableAutoExposure)
  {
    exposure *= ExposureTex[0].r;
  }
  return exposure;
}

float sanitizeExposure(float exposure)
{
  if (!isValidValue(exposure) || exposure <= 0.0f)
  {
    return 1.0f;
  }

  return clamp(exposure, 1.0f / float16Max, float16Max);
}

float sanitizeRadiance(float radiance)
{
  return isValidValue(radiance)
    ? clamp(radiance, 0.0f, float16Max)
    : 0.0f;
}

float3 sanitizeRadiance(float3 radiance)
{
  return float3(
    sanitizeRadiance(radiance.x),
    sanitizeRadiance(radiance.y),
    sanitizeRadiance(radiance.z));
}

float normalizedEVToHistogramOffset(float normalizedEV)
{
  // Remap exposure to bucket (1, size-1)
  return (saturate(normalizedEV) * float(EXPOSURE_HISTOGRAM_SIZE - 2)) + 1;
}

float histogramOffsetToNormalizedEV(float offset)
{
  return saturate((offset - 1) / float(EXPOSURE_HISTOGRAM_SIZE - 2));
}

// Approximation of ACES
// https://knarkowicz.wordpress.com/2016/01/06/aces-filmic-tone-mapping-curve/
float3 ACESFilmApproximation(float3 x)
{
  float a = 2.51f;
  float b = 0.03f;
  float c = 2.43f;
  float d = 0.59f;
  float e = 0.14f;
  return saturate((x*(a*x+b))/(x*(c*x+d)+e));
}

// Fork (DS1): DLSS-NR's SDR curve under the game's image pipeline. The game's display is a saturate of the exposed scene, so
// its darks are linear; ACES's toe flattens them about five times, and the inverse after DLSS-NR scaled every change the
// network made there by as much (boiling, a compressed look in dim interiors). Linear up to the knee, then a soft
// shoulder to 1, so highlights still fit the SDR range.
float3 ds1NeuralRenderingCurve(float3 x)
{
  const float knee = 0.8f;
  const float3 above = max(x - knee, 0.0f);
  return min(x, knee) + (1.0f - knee) * (1.0f - exp(-above / (1.0f - knee)));
}

// DS1 HDR10 output (rtx_hdr_output.h): the tonemapped SDR colour's shoulder above the knee (display linear),
// stretched in log luminance so an SDR 1.0 reaches headroom^strength, hue kept. Below the knee nothing changes.
// Optional: it changes the highlights, which the SDR curve had already fitted under white.
float3 hdrExpandHighlights(float3 color, float knee, float headroom, float strength)
{
  if (strength <= 0.0f)
  {
    return color;
  }
  const float y = calcBt709Luminance(color);
  knee = clamp(knee, 0.05f, 0.95f);
  if (y <= knee)
  {
    return color;
  }
  const float t = (log2(y) - log2(knee)) / (-log2(knee));
  return color * exp2(t * log2(max(headroom, 1.0f)) * strength);
}

float3 ACESFilm(float3 color, bool useLegacyACES, bool suppressBlackLevelClamp = false)
{
  if (useLegacyACES)
  {
    return ACESFilmApproximation(color);
  }
  return ACESFitted(color, suppressBlackLevelClamp);
}
